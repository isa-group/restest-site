---
/*
 * The site's first page: what RESTest is and how to start, then a band for each thing worth knowing, each
 * appearing as it is reached. The run it shows, its figures, faults and pictures of its report, is the one
 * RESTest's manual keeps at the version the site documents (scripts/sync-docs.mjs copies it); a version
 * that keeps none has a first page without those two bands.
 *
 * Each link to a page of the documentation is looked up among the pages built, and the build stops if one
 * is not there, naming it: the first page links chapters of the manual by name, which RESTest could change.
 * The page for coding agents, which RESTest has from 2.5.0 on and holds by a test of its own, is looked up
 * the same way, and the prompt and the band that point at it are left out of a version that does not have it.
 */
import type { ImageMetadata } from 'astro';
import Landing from '../layouts/Landing.astro';
import BlackBox from '../components/landing/BlackBox.astro';
import Install from '../components/landing/Install.astro';
import ReportViews from '../components/landing/ReportViews.astro';
import { arrowIcon, githubIcon } from '../components/landing/icons';
import { minutesInWords, type Landing as LandingData } from '../components/landing/run';
import landing from '../generated/landing.json';
import { siteLinks } from '../components/landing/links';
import ShowcaseBand from '../components/showcase/ShowcaseBand.astro';
import { campaigns } from '../components/showcase/data';
import { repository } from '../../site.config.mjs';

const { version, run, prompt: sentence } = landing as LandingData;
const base = import.meta.env.BASE_URL;

const links = await siteLinks();

// The sentence RESTest's page for coding agents tells a person to give their agent, there from 2.5.0 on.
const prompt = links.agents && sentence;
const pictures = Object.fromEntries(
  Object.entries(
    import.meta.glob<ImageMetadata>('../generated/clinic-run/*.png', { eager: true, import: 'default' }),
  ).map(([path, image]) => [path.replace(/^.*\/(.+)\.png$/, '$1'), image]),
);

// The newest campaign of the showcase, when one is published, for the band "On real APIs".
const campaign = campaigns[0];

// The bands are numbered as they come, and their backgrounds alternate, since three of them may be missing.
const shown = [
  run && 'How it works',
  run && 'The report',
  campaign && 'On real APIs',
  prompt && 'For coding agents',
  'Shaping a run',
  'About us',
].filter((name): name is string => Boolean(name));
/** Where a band comes; the build stops if a band of the page is missing from the list above. */
const place = (name: string) => {
  const at = shown.indexOf(name);
  if (at < 0) throw new Error(`The first page draws a band "${name}" that is not in its list of bands`);
  return at;
};
const kicker = (name: string) => `${String(place(name) + 1).padStart(2, '0')} · ${name}`;
/** A band's class: its background alternates with the band before it. The last band, "About us", has its own. */
const band = (name: string) => (place(name) % 2 ? 'band alt' : 'band');
---

<Landing
  title="RESTest — Automated testing of REST APIs"
  description="RESTest tests a REST API from its OpenAPI document alone: it makes up requests, checks every reply against what the document promised, and reports each fault with the request that shows it."
  version={version}
  links={links}
>
  <section class="hero">
    <p class="badge">Research prototype</p>
    <h1>Automated Testing<br />of REST APIs</h1>
    <p class="lead">For humans, for agents</p>
    <Install version={version} prompt={prompt} />
  </section>

  {
    run && (
      <>
      <section class={band('How it works')}>
        <div class="band-in two reveal">
          <div class="band-copy">
            <div class="kicker">{kicker('How it works')}</div>
            <h2>
              From an API schema to the failures, <span class="second">with nothing to configure.</span>
            </h2>
            <p>
              Give RESTest an OpenAPI document and the address of the API it describes. It makes up requests, checks
              every reply against what the document promised, and reports each failure with a <code>curl</code> command
              that sends the request again.
            </p>
            <ol class="steps">
              <li>
                <b>It reads the document.</b> OpenAPI 2.0, 3.0 or 3.1. It never looks at the API's code, so the API can
                be written in any language and run anywhere.
              </li>
              <li>
                <b>It makes up requests and sends them</b> for as long as you allow: a minute by default.
              </li>
              <li>
                <b>It checks every reply</b> against what the document promised, and says what to fix for each kind of
                failure.
              </li>
            </ol>
          </div>
          <div>
            <BlackBox run={run} />
          </div>
        </div>
      </section>
      <section class={band('The report')}>
        <div class="band-in reveal">
          <div class="band-head">
            <div class="kicker">{kicker('The report')}</div>
            <h2>
              Detailed results <span class="second">at a glance.</span>
            </h2>
            <p>
              A run writes <code>report.html</code> beside <code>report.json</code>: one file that opens in any browser,
              with no network, in light and dark.
            </p>
          </div>
          <ReportViews title={run.title} pictures={pictures} />
          <p class="rp-cap">
            A real run: Spring PetClinic REST, as the{' '}
            <a href="https://github.com/WebFuzzing/Dataset">Web Fuzzing Dataset</a> builds it, tested for{' '}
            {minutesInWords(run.minutes)} by RESTest {run.version}.
          </p>
        </div>
      </section>
      </>
    )
  }

  {campaign && <ShowcaseBand campaign={campaign} class={band('On real APIs')} kicker={kicker('On real APIs')} />}

  {prompt && (
  <section class={band('For coding agents')}>
    <div class="band-in two reveal">
      <div class="band-copy">
        <div class="kicker">{kicker('For coding agents')}</div>
        <h2>Your coding agent tests <span class="second">as it builds.</span></h2>
        <p>
          Ask your coding agent to use RESTest while it develops your API: RESTest finds the bugs as they appear, and
          the agent fixes them before they reach you.
        </p>
        <a class="btn ghost" href={links.agents}>RESTest and coding agents <Fragment set:html={arrowIcon} /></a>
      </div>
      <div class="flow">
        <div class="you"><span class="who">You <span class="badge">Experimental feature</span></span><code>{prompt}</code></div>
        <ol>
          <li><b>It installs or updates RESTest</b>, with Homebrew, jbang, the image or the archive, whichever fits.</li>
          <li><b>It makes a quick first pass</b>, a run of one minute, and tells you in a few lines what it found.</li>
          <li>
            <b>It fixes what was found</b>, when developing the API is its task, and checks each fix by sending the
            request again.
          </li>
          <li>
            <b>It offers a deeper pass</b>, with a dictionary of values it writes from the API's document, code and data.
          </li>
        </ol>
      </div>
    </div>
  </section>
  )}

  <section class={band('Shaping a run')}>
    <div class="band-in reveal">
      <div class="band-head">
        <div class="kicker">{kicker('Shaping a run')}</div>
        <h2>Fit a run to your API. <span class="second">Three inputs, each optional.</span></h2>
        <p>A run needs nothing but the document. Each of these makes it fit your API better, and has a chapter of the manual.</p>
      </div>
      <div class="cards3">
        <div class="card">
          <code>--campaign</code><b>A plan</b>
          <p>How a run builds its requests, where their values come from, and which operations it may touch.</p>
          <div class="card-links"><a class="arrow-link" href={links.plans}>Plans, in the manual <Fragment set:html={arrowIcon} /></a></div>
        </div>
        <div class="card">
          <code>--dictionary</code><b>Dictionaries</b>
          <p>Values you know are good: identifiers that exist, names the API holds. A coding agent can write them from the API's document and code.</p>
          <div class="card-links"><a class="arrow-link" href={links.dictionaries}>Dictionaries, in the manual <Fragment set:html={arrowIcon} /></a></div>
        </div>
        <div class="card">
          <code>--set</code><b>Settings</b>
          <p>How the tool itself behaves: how many requests at once, how long to wait for a reply, and switches that each turn off one thing a run does.</p>
          <div class="card-links"><a class="arrow-link" href={links.settings}>Settings, in the manual <Fragment set:html={arrowIcon} /></a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="band contact">
    <div class="band-in reveal">
      <div class="band-head">
        <div class="kicker">{kicker('About us')}</div>
        <h2>Do you need help? <span class="second">Contact us.</span></h2>
        <p>
          RESTest is a research prototype developed by the SCORE Research Lab at the University of Seville (Spain). If
          you would like to try it on your organisation's APIs and need help, let us know, we will be glad to help.
        </p>
        <div class="links">
          <a class="btn" href="mailto:sergiosegura@us.es">Write to us <Fragment set:html={arrowIcon} /></a>
          <a class="btn ghost" href={`${repository}/issues/new`}><Fragment set:html={githubIcon} /> Ask on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Landing>

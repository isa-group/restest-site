---
/*
 * report.html of the run, in three views a tab picks: the top of the page, an operation opened at a fault,
 * and what was found. The pictures are RESTest's own, from its manual, in the theme the reader picked,
 * taken at twice the page's resolution so that their text stays sharp on any screen; the browser fetches
 * the size the screen needs, and only for the view shown. The frame keeps the height of the tallest, so that
 * picking a tab moves nothing below it. A picture opens at its full size, which on a phone is the only way
 * to read it. Without JavaScript, the three are shown one under another.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tab, panel } from './tabs';

interface Props {
  title: string | null;
  pictures: Record<string, ImageMetadata>;
}
const { title, pictures } = Astro.props;

const views = [
  {
    id: 'summary',
    name: 'Summary and timeline',
    alt: 'The top of report.html for the run: four cards counting the replies by class of status code, the errors and the warnings by kind, and the operations by what was found on them, then the timeline of the run',
  },
  {
    id: 'fault',
    name: 'A failure, in full',
    alt: 'An operation opened in report.html: how its replies divided, a button for each kind of fault found on it, and the first fault of the first kind written out whole, the request beside the reply',
  },
  {
    id: 'found',
    name: 'What was found',
    alt: 'What was found in report.html: each kind of fault, errors first, with what to look at, the classes of status code it came back in, and on how many operations',
  },
];
const tallest = Object.values(pictures).reduce((a, b) => (b.height / b.width > a.height / a.width ? b : a));
const picture = { width: 2160, quality: 90 };
const fullSize = Object.fromEntries(
  await Promise.all(
    Object.entries(pictures).map(async ([name, src]) => [name, (await getImage({ src, ...picture })).src]),
  ),
);
---

<div class="rp" data-tabs>
  <div class="tabs rp-tabs" role="tablist" aria-label="Parts of the report">
    {views.map((view, i) => <button {...tab('view', view.id, i === 0)}>{view.name}</button>)}
  </div>
  <div class="rp-win">
    <div class="rp-bar" aria-hidden="true"><i></i><i></i><i></i><span>report.html{title && ` — ${title}`}</span></div>
    <div class="rp-views" style={`--rp-ratio: ${tallest.width} / ${tallest.height}`}>
      {
        views.map((view, i) => (
          <div {...panel('view', view.id, i === 0)}>
            <h3>{view.name}</h3>
            {['light', 'dark'].map((theme) => (
              <a class={`for-${theme}`} href={fullSize[`${view.id}-${theme}`]} title="Open at full size">
                <Image
                  src={pictures[`${view.id}-${theme}`]}
                  alt={view.alt}
                  {...picture}
                  widths={[1080, 2160]}
                  sizes="(min-width: 1112px) 1078px, calc(100vw - 34px)"
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>
